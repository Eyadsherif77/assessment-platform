# ==============================================================================
# FARABI AI — LOCAL WINDOWS INGESTION WORKER CONFIGURATION
# Copy this file to .env.worker and populate with your local configuration.
# ZERO DATABASE CREDENTIALS: All cloud sync uses HTTPS Cloud-Side Gateway.
# ==============================================================================

# Local Server Binding (Must be strictly 127.0.0.1 loopback)
WORKER_PORT=5050
WORKER_HOST=127.0.0.1

# Allowed Origins (CORS & CSRF Protection)
ALLOWED_ORIGINS=https://farabi-ai.com,https://www.farabi-ai.com,http://localhost:5173,http://localhost:3000

# Cloud Gateway Base URL (Secure HTTPS API Proxy - NO DIRECT TiDB ACCESS)
FARABI_CLOUD_GATEWAY_URL=https://farabi-ai.com

# Asymmetric RS256 Verification Key (Public Key ONLY - No Private Key or Symmetric Secrets)
# Paste the Cloud Platform's Public Key PEM here or point to file
WORKER_PUBLIC_KEY_FILE=keys/worker_public_key.pem

# Local Storage Directory for Original Scanned PDFs (Fast local recovery)
LOCAL_STORAGE_DIR=C:\FarabiAI\storage\books

# Google Gemini API Key (Multimodal Vision OCR - local execution)
GEMINI_API_KEY=your_gemini_api_key_here

# OCR & Batch Tuning
OCR_BATCH_PAGE_LIMIT=20
GEMINI_OCR_MAX_CONCURRENCY=2
