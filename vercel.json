{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://server-mocha-sigma-86.vercel.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://server-mocha-sigma-86.vercel.app/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
