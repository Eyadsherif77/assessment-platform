# Server Configuration
PORT=5000

# JWT Secret (CHANGE THIS to a long random string in production!)
JWT_SECRET=your-very-long-secret-key-change-this-in-production

# Optional: External PostgreSQL URL (leave commented for SQLite embedded mode)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS: comma-separated list of allowed frontend origins
# CORS_ORIGIN=https://your-app.vercel.app,https://your-custom-domain.com

# Optional: Gemini API Key for AI question generation
# GEMINI_API_KEY=your-gemini-api-key-here
