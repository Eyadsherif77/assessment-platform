{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "bundled_assets/visual/**"
    },
    "dist/server.js": {
      "includeFiles": "bundled_assets/visual/**"
    }
  },
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "dist/server.js",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
