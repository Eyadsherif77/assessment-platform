{
  "version": 2,
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "dist/server.js",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "x-matched-path"
        }
      ],
      "destination": {
        "type": "service",
        "service": "web"
      }
    },
    {
      "source": "/uploads/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "x-matched-path"
        }
      ],
      "destination": {
        "type": "service",
        "service": "web"
      }
    },
    {
      "source": "/health",
      "missing": [
        {
          "type": "header",
          "key": "x-matched-path"
        }
      ],
      "destination": {
        "type": "service",
        "service": "web"
      }
    },
    {
      "source": "/",
      "missing": [
        {
          "type": "header",
          "key": "x-matched-path"
        }
      ],
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
