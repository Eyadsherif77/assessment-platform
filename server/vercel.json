{
  "version": 2,
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "dist/server.js",
      "buildCommand": "npm run build",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
