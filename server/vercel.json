{
  "version": 2,
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "dist/server.js",
      "buildCommand": "npm run build"
    }
  },
  "crons": [
    {
      "path": "/api/books/jobs/cron-recover",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
